# MongoDB Atlas connection string (free M0 cluster is fine)
MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/
# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Google OAuth Web client ID, same value in both (leave empty to hide the Google button)
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Comma-separated emails that become admin when they sign up
ADMIN_EMAILS=
# Sends password reset codes. Port 465 uses TLS from the start, others upgrade with STARTTLS.
# Left empty: local dev prints the code in the server log; production refuses reset requests.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender, e.g. Job Radar <you@example.com> (defaults to SMTP_USER)
SMTP_FROM=
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=
# 1 = read test/fixtures instead of calling the job boards (local dev)
SOURCES_DEMO=
